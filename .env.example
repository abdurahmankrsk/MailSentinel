# MailSentinel environment variables.
# Copy to .env and fill in real values. .env is gitignored -- never commit real values.
# Every variable below is read server-side only.

# --- Database (Supabase Postgres in real deployments) ---
# For local exploration you can point these at a local H2 file DB instead, e.g.
#   SPRING_DATASOURCE_URL=jdbc:h2:file:./data/mailsentinel-local;MODE=PostgreSQL;NON_KEYWORDS=USER
#   SPRING_DATASOURCE_USERNAME=sa
#   SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- AI providers (PREMIUM AI analysis) ---
# Only the provider named by ai.provider.active needs a key.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Bring-your-own AI key ---
# A long, random secret used to encrypt users' own AI API keys at rest (AES, via
# spring-security-crypto). Leave blank to disable the feature entirely -- the
# frontend then hides the "use your own key" option, the same way it hides Google
# sign-in when GOOGLE_CLIENT_ID is blank. Changing this value after keys have been
# saved makes them undecryptable, so treat it like a database credential: generate
# once, store safely, never rotate casually.
BYOK_ENCRYPTION_KEY=

# --- Google sign-in ("Continue with Google") ---
# The OAuth 2.0 Web application *client ID* from the Google Cloud console.
# This value is public by design: it identifies the app to Google and is visible in the
# browser. Leave blank to disable Google sign-in -- the frontend then hides the button.
#
# No client secret is required. This app uses the Google Identity Services ID-token
# flow, where the browser receives a signed ID token and the server verifies it; the
# authorization-code exchange that would need a secret never happens. Do not add a
# client secret here.
GOOGLE_CLIENT_ID=

# --- Admin ---
# Comma-separated emails granted the ADMIN role (used by /api/admin/**).
ADMIN_EMAILS=
