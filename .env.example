# MailSentinel environment variables.
# Copy to .env and fill in real values. .env is gitignored -- never commit real values.
# Every variable below is read server-side only.

# --- Server ---
# Port to bind. Defaults to 8080. Container platforms (Render, Railway, Fly, Heroku)
# assign a port and inject it under this exact name, so leaving it unset is correct
# almost everywhere -- set it only when you want a specific local port.
PORT=

# --- Database (Supabase Postgres in real deployments) ---
# For local exploration you can point these at a local H2 file DB instead, e.g.
#   SPRING_DATASOURCE_URL=jdbc:h2:file:./data/mailsentinel-local;MODE=PostgreSQL;NON_KEYWORDS=USER
#   SPRING_DATASOURCE_USERNAME=sa
#   SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- AI providers (PREMIUM AI analysis) ---
# Only the provider named by ai.provider.active needs a key.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Bring-your-own AI key ---
# A long, random secret used to encrypt users' own AI API keys at rest (AES, via
# spring-security-crypto). Leave blank to disable the feature entirely -- the
# frontend then hides the "use your own key" option, the same way it hides Google
# sign-in when GOOGLE_CLIENT_ID is blank. Changing this value after keys have been
# saved makes them undecryptable, so treat it like a database credential: generate
# once, store safely, never rotate casually.
BYOK_ENCRYPTION_KEY=

# The base URL a user supplies is fetched by this server, first to validate the key
# and then on every scan that uses it, so only public HTTPS endpoints are allowed --
# otherwise the feature is a server-side request forgery primitive aimed at
# 127.0.0.1, your private network, or the cloud metadata service at 169.254.169.254.
# Set this to true ONLY on a single-user or trusted-user deployment where you want to
# point the feature at a self-hosted model on localhost or your own LAN. On anything
# with open registration, leave it unset.
BYOK_ALLOW_PRIVATE_ENDPOINTS=

# --- Google sign-in ("Continue with Google") ---
# The OAuth 2.0 Web application *client ID* from the Google Cloud console.
# This value is public by design: it identifies the app to Google and is visible in the
# browser. Leave blank to disable Google sign-in -- the frontend then hides the button.
#
# No client secret is required. This app uses the Google Identity Services ID-token
# flow, where the browser receives a signed ID token and the server verifies it; the
# authorization-code exchange that would need a secret never happens. Do not add a
# client secret here.
GOOGLE_CLIENT_ID=

# --- Admin ---
# Comma-separated emails granted the ADMIN role (used by /api/admin/**).
ADMIN_EMAILS=

# --- Rate limiting ---
# Abuse ceilings on login, registration, scanning and bring-your-own-key saves.
# Blank or true = on, which is what you want anywhere with open registration.
# Per-endpoint quotas live in application.properties under mailsentinel.rate-limit.*.
RATE_LIMIT_ENABLED=
#
# Where the client's address is read from. Set to true when a proxy that sets
# X-Forwarded-For sits in front of the app -- which is the case on Render, Railway,
# Fly and Heroku, where getRemoteAddr() is the platform's proxy for every caller in
# the world and a per-IP limit read from it would throttle all users as one.
# Leave blank/false when the app is reached directly: the header is caller-supplied,
# so trusting it without a proxy hands an attacker a fresh identity per request and
# disables the limiter entirely.
RATE_LIMIT_TRUST_FORWARDED_FOR=
