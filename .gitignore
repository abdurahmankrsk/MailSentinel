# Java / Maven
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Local H2 database files (used for local runs before Supabase is configured)
app/data/
*.mv.db
*.trace.db

# Node
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# Local AI-tool configuration (not part of the project)
.agents/
.claude/
.codex/
.impeccable/
skills-lock.json

# Secrets -- DB credentials and AI provider keys are read from real environment
# variables only (see app/src/main/resources/application.properties), never from
# a committed file, but ignore common secret-carrying files/patterns defensively.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
id_rsa
id_ed25519
*credentials*.json
*service-account*.json
secrets.json
*.secrets
